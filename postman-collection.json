{
  "info": {
    "_postman_id": "8c51362b-e8d5-4ecf-8c79-9f8080ecf20d",
    "name": "hotel-booking-api",
    "description": "Role-based Hotel Booking API — Auth + User modules.\n\nPublic endpoint:\n  • POST /auth/login  → returns a JWT in `authentication`\n\nProtected endpoints (need apikey + Bearer token):\n  • everything under /users\n\nSee POSTMAN_TESTING_GUIDE.md for a full beginner walkthrough.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs BEFORE every request. Nothing to do here by default."
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs AFTER every request (request → folder → collection).",
          "// Protected endpoints rotate the JWT and return it in X-Access-Token.",
          "// Save it so the next request always uses a fresh, valid token.",
          "// (login doesn't set this header, so the guard leaves the login token intact.)",
          "if (pm.response.headers.has('X-Access-Token')) {",
          "  pm.environment.set('token', pm.response.headers.get('X-Access-Token'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "auth",
      "description": "Public authentication endpoints. You only need the apikey header here — no token yet.",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns a JWT in authentication', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.authentication).to.be.a('string');",
                  "  pm.expect(j.authentication.split('.')).to.have.length(3);",
                  "});",
                  "",
                  "// Save the fresh token so every later request is authenticated.",
                  "const body = pm.response.json();",
                  "if (body.authentication) {",
                  "  pm.environment.set('token', body.authentication);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"steph@mail.com\",\n    \"password\": \"pass1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_address}}/auth/login",
              "host": ["{{api_address}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates with email + password. On success returns a JWT in the `authentication` field; the test script stores it into the `token` variable automatically.\n\n401 = invalid credentials · 403 = account inactive."
          },
          "response": []
        }
      ]
    },
    {
      "name": "users",
      "description": "CRUD endpoints for the `user` resource. All are protected by API key + JWT.",
      "item": [
        {
          "name": "create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Body says success', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.message).to.eql('User created successfully');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "apikey", "value": "{{api_key}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Steph\",\n    \"middleName\": \"Curry\",\n    \"firstLastName\": \"Curry\",\n    \"secondLastName\": \"\",\n    \"email\": \"steph@mail.com\",\n    \"password\": \"pass1234\",\n    \"role\": 1,\n    \"status\": 1,\n    \"phones\": [\"4444444444\", \"5555555555\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_address}}/users/create",
              "host": ["{{api_address}}"],
              "path": ["users", "create"]
            },
            "description": "Creates a new user. `role` and `status` are numeric foreign keys (see guide §8). Returns 201 on success, 409 if the email already exists.\n\nNote: creating the very FIRST user needs a bootstrap token (guide §6)."
          },
          "response": []
        },
